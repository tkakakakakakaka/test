<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22></text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">

        {% block stylesheets %}
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="bg-white">
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
            <div class="container-fluid">
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_about') }}">accueil</a>
                        </li>
                        {% if is_granted('ROLE_MEDECIN') %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_consultation_index') }}">liste desconsultations</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_consultation_patient') }}">mes patients</a>
                            </li>
                            
                        {% endif %}
                        {% if is_granted('ROLE_PATIENT') %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_consultation_index') }}">liste des consultations</a>
                            </li>
                        {% endif %}

                        {% if is_granted('ROLE_ADMIN') %}
                        <li class="nav-item">
                            <a class="nav-link" href="">je sais pas</a>
                        </li>
                        {% endif %}
           

                        {% if app.user %}
                            <li class="nav-item">
                                 <a class="nav-link" href="{{ path('app_logout') }}">déconnecter</a>
                            </li>
                        {% else %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_login') }}">se connecter</a>
                            </li>
                        {% endif %}
                        <li class="nav-item">
                        {% if app.user %}
                            <div class="user-info">
                                <p class="nav-link" >connecté en tant que : {{ app.user.userIdentifier }}</p>
                            </div>
                        {% endif %}
                    </li>    
                    </ul>
                </div>
            </div>
        </nav>
        {% block body %}{% endblock %}
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    </body>
</html>
