{% extends 'base.html.twig' %}

{% block title %}Traitement index{% endblock %}

{% block body %}
<div class="container my-5">
    <h1 class="mb-4 text-center">Traitement de la consultation {{ consultation.id }}</h1>

    <table class="table table-striped table-hover table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Médicament</th>
                <th>Quantité</th>
                <th>Contenant</th>
                <th>Durée</th>
                <th>Dose</th>
                <th>Fréquence</th>
                <th>Détail du traitement</th>
                <th>Modifier le traitement</th>
            </tr>
        </thead>
        <tbody>
        {% for traitement in traitements %}
            <tr>
                <td>{{ traitement.id }}</td>
                <td>{{ traitement.medicament }}</td>
                <td>{{ traitement.quantite }}</td>
                <td>{{ traitement.contenant }}</td>
                <td>{{ traitement.duree }}</td>
                <td>{{ traitement.dose }}</td>
                <td>{{ traitement.frequence }}</td>
                <td>
                    <a class="btn btn-sm btn-info me-1" href="{{ path('app_traitement_show', {'cid': consultation.id, 'tid': traitement.id}) }}">
                        Voir les détails du traitement
                    </a>
                </td>
                <td>
                    <a class="btn btn-sm btn-info me-1" href="{{ path('app_traitement_edit', {'cid': consultation.id, 'tid': traitement.id}) }}">
                        Modifier
                    </a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8" class="text-center">Aucun enregistrement trouvé</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <div class="text-center mt-4">
        <a class="btn btn-primary btn-lg me-2" href="{{ path('app_traitement_new', {'id': consultation.id}) }}">
            Créer un nouveau traitement
        </a>
        <a class="btn btn-secondary btn-lg" href="{{ path('app_consultation_index') }}">
            Retour aux consultations
        </a>
    </div>
</div>
{% endblock %}
