{% extends 'base.html.twig' %}

{% block title %}Consultation index{% endblock %}

{% block body %}
<div class="container my-5">
    <h1 class="mb-4 text-center">Liste des utilisateur</h1>

       
    <form method="get" class="mb-3 text-center">
        <input type="text" name="filtre3" placeholder="Rechercher" value="{{ filtre3|default('') }}">
        <button type="submit" class="btn btn-primary btn-sm">Rechercher</button>
    </form>


    <table class="table table-striped table-hover table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Email</th>
                <th>Roles</th>
                <th>Password</th>
                <th>Ssn</th>
                <th>Nom</th>
                <th>Prenom</th>
                <th>Genre</th>
                <th>détails</th>
            </tr>
        </thead>
        <tbody>
        {% for user in pagination  %}
            <tr>
                <td>{{ user.id }}</td>
                <td>{{ user.email }}</td>
                <td>{{ user.roles ? user.roles|json_encode : '' }}</td>
                <td>{{ user.password }}</td>
                <td>{{ user.ssn }}</td>
                <td>{{ user.nom }}</td>
                <td>{{ user.prenom }}</td>
                <td>{{ user.genre }}</td>
                <td>
                    <a class="btn btn-sm btn-info me-1" href="{{ path('app_user_show', {'id': user.id}) }}">Détails</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5" class="text-center">Aucun enregistrement trouvé</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <div class="d-flex justify-content-center mt-3">
        {{ knp_pagination_render(pagination) }}
    </div>

    
</div>
{% endblock %}
