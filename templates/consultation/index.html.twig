{% extends 'base.html.twig' %}

{% block title %}Consultation index{% endblock %}

{% block body %}
<div class="container my-5">
    <h1 class="mb-4 text-center">Liste des consultations</h1>

       
    <form method="get" class="mb-3 text-center">
        <input type="text" name="filtre" placeholder="Rechercher" value="{{ filtre|default('') }}">
        <button type="submit" class="btn btn-primary btn-sm">Rechercher</button>
    </form>


    <table class="table table-striped table-hover table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Age</th>
                <th>Description</th>
                <th>Date</th>
                <th>Détail de la consultation</th>
                <th>Modifier</th>
                <th>Consulter les traitements</th>
            </tr>
        </thead>
        <tbody>
        {% for consultation in pagination  %}
            <tr>
                <td>{{ consultation.id }}</td>
                <td>{{ consultation.age }}</td>
                <td>{{ consultation.description|slice(0, 20) ~ (consultation.description|length > 20 ? '...' : '') }}</td>
                <td>{{ consultation.date ? consultation.date|date('Y-m-d') : '' }}</td>
                <td>
                    <a class="btn btn-sm btn-info me-1" href="{{ path('app_consultation_show', {'id': consultation.id}) }}">Voir les détails de la consultation</a>
                </td>
                <td>
                    <a class="btn btn-sm btn-info me-1" href="{{ path('app_consultation_edit', {'id': consultation.id}) }}">Modifier</a>
                </td>
                <td>
                    <a class="btn btn-sm btn-info me-1" href="{{ path('app_traitement_index', {'id': consultation.id}) }}">Consulter les traitements</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5" class="text-center">Aucun enregistrement trouvé</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <div class="d-flex justify-content-center mt-3">
        {{ knp_pagination_render(pagination) }}
    </div>

    <div class="text-center mt-4">
        <a class="btn btn-primary btn-lg" href="{{ path('app_consultation_new') }}">Créer une nouvelle consultation</a>
    </div>
</div>
{% endblock %}
